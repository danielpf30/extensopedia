# ==============================================================================
# Extensopedia - Variáveis de Ambiente para Banco de Dados (PostgreSQL)
# ==============================================================================
# ATENÇÃO:
# - Nunca faça commit do arquivo '.env' preenchido com credenciais reais.
# - Utilize 'make generate-secrets' ou 'python scripts/generate-passwords.py'
#   para gerar senhas fortes criptograficamente (NF010, NF011).
# - O PostgreSQL está configurado com autenticação 'scram-sha-256' e princípio
#   do menor privilégio (papéis separados para dono/migrações e aplicação).
# ==============================================================================

# Porta mapeada no host (ligada exclusivamente a 127.0.0.1)
POSTGRES_PORT=5432

# Nome do banco de dados principal
POSTGRES_DB=extensopedia

# Nome do banco de dados usado pelos testes automatizados
POSTGRES_TEST_DB=extensopedia_test

# 1. Administrador do PostgreSQL (Superusuário do container)
# Usado para provisionamento inicial e tarefas administrativas do container.
POSTGRES_USER=extensopedia_admin
POSTGRES_PASSWORD=altere_para_uma_senha_forte_ou_gere_via_script

# 2. Usuário Dono / Migrations (DDL + DML)
# Utilizado exclusivamente por ferramentas de migração de schema
# Possui permissão para criar, alterar e remover tabelas.
DB_MIGRATION_USER=extensopedia_owner
DB_MIGRATION_PASSWORD=altere_para_uma_senha_forte_ou_gere_via_script

# 3. Usuário da Aplicação (Apenas DML)
# Utilizado pelo backend da plataforma em tempo de execução.
# Permissões concedidas: SELECT, INSERT, UPDATE, DELETE e USAGE em sequences.
# Permissões bloqueadas: CREATE, ALTER, DROP, TRUNCATE de objetos no schema public.
# ------------------------------------------------------------------------------
DB_APP_USER=extensopedia_app
DB_APP_PASSWORD=altere_para_uma_senha_forte_ou_gere_via_script
